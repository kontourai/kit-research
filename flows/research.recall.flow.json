{
  "id": "research.recall",
  "version": "1.1",
  "description": "Query prior captured and compiled knowledge. Results must carry provenance so every recalled item traces back to its original source.",
  "steps": [
    { "id": "form-query", "next": "retrieve-results" },
    { "id": "retrieve-results", "next": "verify-provenance" },
    { "id": "verify-provenance", "next": "done" },
    { "id": "done", "next": null }
  ],
  "gates": {
    "form-query-gate": {
      "step": "form-query",
      "expects": [
        {
          "id": "query-formed",
          "kind": "trust.bundle",
          "required": true,
          "description": "A query intent has been formed (keyword terms, topic, or semantic vector). The query scope (captured sources, compiled insights, or both) must be specified.",
          "bundle_claim": {
            "claimType": "research.recall.query",
            "subjectType": "artifact",
            "accepted_statuses": ["trusted", "accepted"]
          }
        }
      ]
    },
    "retrieve-results-gate": {
      "step": "retrieve-results",
      "expects": [
        {
          "id": "results-retrieved",
          "kind": "trust.bundle",
          "required": true,
          "description": "Results matching the query have been retrieved from the knowledge store. An empty result set is valid; retrieval failure or timeout is not.",
          "bundle_claim": {
            "claimType": "research.recall.results",
            "subjectType": "artifact",
            "accepted_statuses": ["trusted", "accepted"]
          }
        }
      ]
    },
    "verify-provenance-gate": {
      "step": "verify-provenance",
      "expects": [
        {
          "id": "results-carry-provenance",
          "kind": "trust.bundle",
          "required": true,
          "description": "Every non-empty result carries a provenance reference back to its originating captured source (source_id or source_ref). Results without traceable provenance must be excluded before this gate can pass.",
          "bundle_claim": {
            "claimType": "research.recall.provenance-verified",
            "subjectType": "artifact",
            "accepted_statuses": ["trusted", "accepted"]
          }
        }
      ]
    }
  }
}
