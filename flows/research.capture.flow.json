{
  "id": "research.capture",
  "version": "1.0",
  "description": "Ingest a source (transcript, article, URL) with provenance. Gates require the source reference and classification to be recorded before advancing.",
  "steps": [
    { "id": "receive-source", "next": "record-provenance" },
    { "id": "record-provenance", "next": "classify-source" },
    { "id": "classify-source", "next": "done" },
    { "id": "done", "next": null }
  ],
  "gates": {
    "receive-source-gate": {
      "step": "receive-source",
      "expects": [
        {
          "id": "source-content-received",
          "kind": "surface.claim",
          "required": true,
          "description": "The source text, URL, or transcript has been received and is non-empty.",
          "claim": {
            "type": "research.capture.source-received",
            "subject": "artifact",
            "accepted_statuses": ["trusted", "accepted"]
          }
        }
      ]
    },
    "record-provenance-gate": {
      "step": "record-provenance",
      "expects": [
        {
          "id": "source-ref-recorded",
          "kind": "surface.claim",
          "required": true,
          "description": "The source reference (URL, citation, or attribution) has been recorded. A source without a traceable ref must not advance.",
          "claim": {
            "type": "research.capture.provenance-ref",
            "subject": "artifact",
            "accepted_statuses": ["trusted", "accepted"]
          }
        }
      ]
    },
    "classify-source-gate": {
      "step": "classify-source",
      "expects": [
        {
          "id": "classification-recorded",
          "kind": "surface.claim",
          "required": true,
          "description": "The source has been classified with a non-empty category (e.g. 'transcript', 'article', 'reference', 'discussion') and a content-type label. Classification must be stored alongside the provenance ref.",
          "claim": {
            "type": "research.capture.classification",
            "subject": "artifact",
            "accepted_statuses": ["trusted", "accepted"]
          }
        }
      ]
    }
  }
}
